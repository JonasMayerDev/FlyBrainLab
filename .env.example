# Non-secret settings only. This is documentation, not automatically loaded.
# Keys are entered without echo via scripts/with_credentials.py, or supplied
# in the parent process environment. Do not put real keys into this file.
# Secret variable names: ANTHROPIC_API_KEY, BRIGHTDATA_API_KEY

# Copy zone NAMES from your activated BrightData products (not redemption codes).
BRIGHTDATA_TRANSPORT=rest
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_MAX_REQUESTS=10
BRIGHTDATA_MAX_COST_USD=1
# Set the conservative unit price from YOUR active account/product plan.
# Leaving this empty prevents live requests; do not guess a zero price.
BRIGHTDATA_ESTIMATED_REQUEST_COST_USD=

# Alternative: --brightdata-mcp in scripts/with_credentials.py selects MCP.
# It needs no SERP/Unlocker zone and defaults to at most TWO counted attempts.
# Verify the remaining shared free pool in your actual account first, then
# enter that count interactively; the helper supplies estimate/cap=0 locally.
# BRIGHTDATA_FREE_REQUEST_ALLOWANCE=

# Default KB on macOS: ~/Library/Application Support/FlyDiscovery/knowledgebase
# RESEARCH_KB_DIR=

# Omnigent runtime state is outside the iCloud project, never published.
# Launch wrapper uses ~/Library/Application Support/FlyDiscovery/omnigent
# without overriding HOME.
OMNIGENT_NO_UPDATE_CHECK=1
OMNIGENT_HOST_NO_OPEN=1
